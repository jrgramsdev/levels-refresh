{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="Announcement">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
      {{ section.settings.text }}
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Free shipping on orders over $50 · <strong>Follow @LevelsSmoke for weekly drops</strong></p>" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [
    { "name": "Announcement bar" }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
