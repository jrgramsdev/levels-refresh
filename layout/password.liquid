<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} &mdash; Coming Soon</title>
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body class="template-password">
  <main style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;">
    <div style="max-width:520px;text-align:center;">
      <div class="brand" style="justify-content:center;font-size:24px;margin-bottom:24px;">
        <span class="dot"></span>
        <span>{{ shop.name }}</span>
      </div>
      <h1 style="font-family:var(--font-display);font-size:48px;font-weight:700;letter-spacing:-.03em;margin-bottom:14px;">Opening soon.</h1>
      <p style="color:var(--fg-dim);font-size:17px;line-height:1.55;margin-bottom:32px;">Sign up to be the first to know when we go live.</p>
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="prospect, password page">
        <div style="display:flex;gap:8px;max-width:420px;margin:0 auto;">
          <input type="email" name="contact[email]" placeholder="you@email.com" required style="flex:1;padding:14px 18px;border-radius:999px;border:1px solid var(--fg-line);background:var(--bg-2);color:var(--fg);outline:none;">
          <button type="submit" class="btn btn-primary">Notify me</button>
        </div>
        {% if form.posted_successfully? %}<p style="color:var(--success);margin-top:14px;font-size:13px;">Thanks — we'll let you know.</p>{% endif %}
      {% endform %}
      <div style="margin-top:48px;">
        {{ content_for_layout }}
      </div>
    </div>
  </main>
</body>
</html>
