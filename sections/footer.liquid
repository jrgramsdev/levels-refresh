<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="brand" href="{{ routes.root_url }}">
        <span class="dot"></span>
        <span>{{ settings.brand_name | default: shop.name }}</span>
      </a>
      {%- if section.settings.tagline != blank -%}
        <p>{{ section.settings.tagline }}</p>
      {%- endif -%}
      <div class="footer-social">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', icon: 'instagram' %}</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', icon: 'facebook' %}</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', icon: 'tiktok' %}</a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', icon: 'youtube' %}</a>{%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'links' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when 'text' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            <div style="color:var(--fg-dim);font-size:14px;line-height:1.55;">{{ block.settings.text }}</div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer-bottom">
    <div>© {{ 'now' | date: '%Y' }} {{ shop.name }} · All rights reserved.</div>
    <div class="footer-payment">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'payment-icon' }}
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Premium glass, hardware, and accessories. Curated drops, real-deal pricing."
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link list",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Hours" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mon–Sat · 10am–9pm<br>Sun · 11am–7pm</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "links" },
      { "type": "links" },
      { "type": "text" }
    ]
  },
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
