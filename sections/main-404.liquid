<section style="text-align:center;padding:120px 24px;max-width:640px;margin:0 auto;">
  <div class="hero-eyebrow">404</div>
  <h1 style="font-family:var(--font-display);font-size:clamp(40px,6vw,72px);font-weight:700;letter-spacing:-.03em;line-height:1.05;margin:18px 0 16px;">Page not found.</h1>
  <p style="color:var(--fg-dim);font-size:17px;margin-bottom:32px;">The page you were looking for doesn't exist — or got moved during a restock.</p>
  <a class="btn btn-primary btn-lg" href="{{ routes.root_url }}">Back to home {% render 'icon', icon: 'arrow-right' %}</a>
</section>

{% schema %}
{ "name": "404" }
{% endschema %}
