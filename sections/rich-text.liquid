<section class="rich-text reveal">
  {%- if section.settings.label != blank -%}<div class="section-label">{{ section.settings.label }}</div>{%- endif -%}
  {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  <div>{{ section.settings.body }}</div>
  {%- if section.settings.cta_label != blank -%}
    <a class="btn" href="{{ section.settings.cta_url | default: '#' }}" style="margin-top:24px;">{{ section.settings.cta_label }}</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for collectors." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>From entry-level setups to high-end glass — every piece on our floor is hand-selected.</p>" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
