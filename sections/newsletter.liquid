<section class="newsletter reveal">
  {%- if section.settings.label != blank -%}<div class="section-label">{{ section.settings.label }}</div>{%- endif -%}
  <h2>{{ section.settings.heading | default: 'Inside the drop.' }}</h2>
  <p>{{ section.settings.subheading | default: 'Weekly drops, restocks, and discounts — straight to your inbox.' }}</p>
  {% form 'customer', class: 'newsletter-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter, prospect">
    <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'you@email.com' }}" aria-label="Email" required>
    <button type="submit" class="btn btn-primary">{{ section.settings.button_label | default: 'Subscribe' }}</button>
    {%- if form.posted_successfully? -%}
      <p style="color:var(--success);margin-top:14px;font-size:13px;width:100%;">Thanks — check your inbox.</p>
    {%- elsif form.errors -%}
      <p style="color:var(--danger);margin-top:14px;font-size:13px;width:100%;">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
    {%- endif -%}
  {% endform %}
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Inside the drop." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Weekly drops, restocks, and discounts — straight to your inbox." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "you@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
