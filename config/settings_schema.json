[
  {
    "name": "theme_info",
    "theme_name": "Levels Refresh",
    "theme_version": "1.0.0",
    "theme_author": "Joshua Grams",
    "theme_documentation_url": "https://joshuagrams.com",
    "theme_support_url": "mailto:josh@3grams.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "header",
        "content": "Logo & favicon"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (optional — falls back to text)"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 130
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "og_image",
        "label": "Default share image (1200×630)"
      },
      {
        "type": "header",
        "content": "Brand text"
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "LEVELS"
      },
      {
        "type": "text",
        "id": "brand_tag",
        "label": "Brand tagline (next to logo)",
        "default": "smoke shop"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_fg",
        "label": "Text",
        "default": "#f5f5f7"
      },
      {
        "type": "color",
        "id": "color_signal",
        "label": "Accent (CTA, badges)",
        "default": "#0f8f45"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "helvetica_n4"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Open cart in drawer (vs. cart page)",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_note",
        "label": "Free-shipping / cart note",
        "default": "Free shipping on orders over $50."
      }
    ]
  },
  {
    "name": "Age gate",
    "settings": [
      {
        "type": "checkbox",
        "id": "age_gate_enabled",
        "label": "Show 21+ age gate on first visit",
        "default": true
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL",
        "default": "https://instagram.com/levelssmoke"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
    ]
  }
]
